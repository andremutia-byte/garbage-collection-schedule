# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase Data Platform (Clerk Third-Party Auth Integration)
# Format: https://<project-ref>.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable API key (formerly known as anon public key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Server-only Service Role Secret Key (for administrative tasks / webhooks)
# NEVER prefix with NEXT_PUBLIC_ and NEVER import on client-side
SUPABASE_SERVICE_ROLE_KEY=
